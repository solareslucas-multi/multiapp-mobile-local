# =============================================================================
# GrowthBook self-hosted — local development defaults
#
#   cp .env.example .env
#
# Defaults are dev-only and shared with the repo on purpose, so everyone who
# clones this repo gets a working local GrowthBook out of the box. Change
# values in your own `.env` (never commit it) if you want something different.
# =============================================================================

# --- Admin account (auto-provisioned by `make seed` on a fresh install) ------
GB_ADMIN_NAME=MultiApp Admin
GB_ADMIN_EMAIL=admin@multiapp.local
GB_ADMIN_PASSWORD=multiapp-local-2026
GB_ORG_NAME=MultiApp

# SDK connection auto-created by `make seed` for your mobile app
GB_SDK_NAME=Multiapp Mobile
GB_SDK_LANGUAGE=react # android | ios | flutter | react | nodejs | ...

# --- GrowthBook secrets (fixed dev defaults; override for shared envs) -------
JWT_SECRET=dev-only-multiapp-jwt-secret-not-for-production
ENCRYPTION_KEY=dev-only-multiapp-encryption-key-not-for-production

# --- MongoDB ----------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=growthbook